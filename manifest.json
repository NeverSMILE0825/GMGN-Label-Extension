{
  "manifest_version": 3,
  "name": "GMGN Team Labels",
  "version": "1.1.2",
  "description": "Replace GMGN trader addresses with labels for wallets on your team list.",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_title": "GMGN Team Labels",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://gmgn.ai/*", "https://www.gmgn.ai/*"],
      "js": ["shared.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
